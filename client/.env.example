# Frontend API Configuration
# You can set either the backend domain (e.g. https://api.example.com)
# or a full API base ending with /api.
VITE_API_URL=https://schooldekho-api.onrender.com

# Google Maps API Key
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Public site URL used for SEO canonical and social tags
VITE_SITE_URL=https://schooldekho.vercel.app

# Environment
VITE_APP_ENV=production
